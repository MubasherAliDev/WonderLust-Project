<% layout("/layouts/Boilerplate") %>
<div class="row mt-3">
  <div class="col-8 offset-2">
    <h2>Add New Listing</h2>
    <form
      method="POST"
      action="/listings"
      novalidate
      class="row g-3 needs-validation"
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
          name="listing[title]"
          placeholder="Enter Title"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Choose a Title</div>
      </div>
      <div class="mb-3">
        <label for="Description" class="form-label">Description</label>
        <input
          name="listing[description]"
          placeholder="Enter Description"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Please Enter Description</div>
      </div>
     <div class="mb-3">
       <label for="image" class="form-label">Upload Image</label>
        <input
          name="listing[image]"
          type="file"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Enter image URL</div>
      </div>
      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price</label>
          <input
            name="listing[price]"
            placeholder="Enter Price"
            type="number"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Price Should be Valid</div>
        </div>
        <div class="mb-3">
          <!-- //categroy ka liye filter -->
  <label for="category" class="form-label">Category</label>
  <select name="listing[category]" id="category" class="form-select" required>
    <option value="" disabled selected>Select a category</option>
    <option value="Trending">Trending</option>
    <option value="Rooms">Rooms</option>
    <option value="Iconic Cities">Iconic Cities</option>
    <option value="Mountains">Mountains</option>
    <option value="Castles">Castles</option>
    <option value="Luxury Places">Luxury Places</option>
    <option value="Farms">Farms</option>
    <option value="Arctic">Arctic</option>
  </select>
</div>
        <div class="mb-3 col-md-8">
          <label for="location" class="form-label">Location</label>
          <input
            name="listing[location]"
            placeholder="Enter Location"
            type="text"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Location Should be Enter</div>
        </div>
      </div>
      <div class="mb-3">
        <label for="country" class="form-label">Country</label>
        <input
          name="listing[country]"
          placeholder="Enter Country"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Country must be Enter</div>
      </div>

      <button class="btn btn-dark add mt-3">Add</button>
    </form>
  </div>
</div>
