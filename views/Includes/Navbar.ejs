<style>
  /* Navbar and search */

  /* Search button */

  .btn-search {
    background-color: #fe424d;
    color: #ffffff;
    border: none;
    border-radius: 25px;
    padding: 0.55rem 1rem;
    transition: all 0.2s ease;
  }

  .btn-search:hover {
    background-color: #e93642;
    color: #ffffff;
  }

  .btn-search i {
    margin-right: 0.5rem;
  }


  /* Search input */

  .search-inp {
    border-radius: 25px;
    border: 1px solid #dddddd;
    transition: all 0.2s ease;
  }

  .search-inp:focus {
    border-color: #fe424d;
    box-shadow: 0 0 0 3px rgba(254, 66, 77, 0.08);
  }


  /* Search suggestions */

  .suggestions-box {
    top: 100%;
    left: 0;
    width: 100%;
    max-height: 280px;

    margin-top: 6px;
    overflow-y: auto;

    display: none;

    background-color: #ffffff;
    border: 1px solid #eeeeee;
    border-radius: 12px;

    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.10);

    z-index: 2000;
  }

  .suggestions-box .list-group-item {
    padding: 0.75rem 1rem;

    border: none;
    border-bottom: 1px solid #f1f1f1;

    background-color: #ffffff;

    cursor: pointer;

    font-size: 0.85rem;

    transition: background-color 0.2s ease;
  }

  .suggestions-box .list-group-item:hover {
    background-color: #fff4f4;
  }


  /* Mobile search */

  .mobile-search-row {
    display: none;
  }


  /* Mobile navbar */

  @media (max-width: 991.98px) {

    /* Navbar layout */

    .navbar {
      height: auto;
      min-height: 4.5rem;
      padding: 0.6rem 0 0.75rem;

      background-color: #ffffff;
    }

    .navbar > .container-fluid {
      min-height: 3.2rem;
      align-items: center;
    }


    /* Logo */

    .navbar-brand {
      display: flex;
      align-items: center;
      justify-content: center;

      width: 42px;
      height: 42px;

      margin-left: 0.25rem;

      border-radius: 50%;

      transition: transform 0.2s ease;
    }

    .navbar-brand:active {
      transform: scale(0.94);
    }

    .fa-compass {
      color: #fe424d;
      font-size: 2rem;
    }


    /* Mobile menu button */

    .navbar-toggler {
      width: 44px;
      height: 44px;

      padding: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      background-color: #ffffff;

      border: 1px solid #dedede;
      border-radius: 12px;

      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .navbar-toggler:focus {
      box-shadow: 0 0 0 3px rgba(254, 66, 77, 0.12);
    }


    /* Mobile search bar */

    .mobile-search-row {
      display: block;

      width: 100%;

      padding: 0.45rem 1rem 0;
    }

    .mobile-search-pill {
      position: relative;

      width: 100%;
      height: 52px;

      display: flex;
      align-items: center;

      padding: 0.3rem 0.35rem 0.3rem 1rem;

      background-color: #ffffff;

      border: 1px solid #e4e4e4;
      border-radius: 16px;

      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);

      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
    }

    .mobile-search-pill:focus-within {
      border-color: #fe424d;

      box-shadow:
        0 0 0 3px rgba(254, 66, 77, 0.08),
        0 5px 16px rgba(0, 0, 0, 0.07);
    }


    /* Mobile search input */

    .mobile-search-pill input {
      flex: 1;

      width: 100%;
      min-width: 0;

      padding: 0.5rem 0.5rem 0.5rem 0;

      border: none;
      outline: none;

      background-color: transparent;

      color: #222222;

      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 0.92rem;
      font-weight: 500;
    }

    .mobile-search-pill input::placeholder {
      color: #8b8b8b;
      font-weight: 400;
    }


    /* Mobile search button */

    .mobile-search-pill button {
      width: 42px;
      height: 42px;
      min-width: 42px;

      display: flex;
      align-items: center;
      justify-content: center;

      border: none;
      border-radius: 13px;

      background-color: #fe424d;
      color: #ffffff;

      font-size: 0.9rem;

      cursor: pointer;

      box-shadow: 0 4px 10px rgba(254, 66, 77, 0.22);

      transition:
        transform 0.2s ease,
        background-color 0.2s ease,
        box-shadow 0.2s ease;
    }

    .mobile-search-pill button:hover {
      background-color: #e93642;

      box-shadow: 0 5px 13px rgba(254, 66, 77, 0.28);
    }

    .mobile-search-pill button:active {
      transform: scale(0.93);
    }


    /* Mobile search suggestions */

    .mobile-search-pill .suggestions-box {
      position: absolute;

      top: calc(100% + 8px);
      left: 0;

      width: 100%;
      max-height: 280px;

      overflow-y: auto;

      background-color: #ffffff;

      border: 1px solid #eeeeee;
      border-radius: 14px;

      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);

      z-index: 2000;
    }

    .mobile-search-pill
    .suggestions-box
    .list-group-item {
      padding: 0.85rem 1rem;

      border: none;
      border-bottom: 1px solid #f1f1f1;

      background-color: #ffffff;

      font-size: 0.85rem;

      transition: background-color 0.2s ease;
    }

    .mobile-search-pill
    .suggestions-box
    .list-group-item:hover {
      background-color: #fff5f5;
    }


    /* Mobile navigation menu */

    .navbar-collapse {
      position: absolute;

      top: 4.45rem;
      left: 0;
      right: 0;

      padding: 1rem 1rem 1.25rem;

      background-color: #ffffff;

      border-radius: 0 0 18px 18px;

      box-shadow: 0 12px 25px rgba(0, 0, 0, 0.10);

      z-index: 1050;

      max-height: 0;
      overflow: hidden;

      opacity: 0;

      transition:
        max-height 0.3s ease,
        opacity 0.2s ease;
    }

    .navbar-collapse.show {
      max-height: 500px;
      opacity: 1;
    }


    /* Mobile navigation links */

    .navbar-nav {
      gap: 0.2rem;
    }

    .navbar-nav .nav-link {
      padding: 0.75rem 0.9rem !important;

      border-radius: 10px;

      color: #222222 !important;

      font-size: 0.9rem;
      font-weight: 500;

      transition:
        background-color 0.2s ease,
        color 0.2s ease;
    }

    .navbar-nav .nav-link:hover,
    .navbar-nav .nav-link:active {
      background-color: #fff3f3;
      color: #fe424d !important;
    }


    /* Mobile menu overlay */

    body.menu-open::after {
      content: "";

      position: fixed;

      top: 0;
      left: 0;
      right: 0;
      bottom: 0;

      background: rgba(0, 0, 0, 0.25);

      backdrop-filter: blur(2px);

      z-index: 1040;
    }
  }


  /* Small mobile devices */

  @media (max-width: 380px) {

    .mobile-search-row {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }

    .mobile-search-pill {
      height: 49px;
      border-radius: 15px;
    }

    .mobile-search-pill button {
      width: 39px;
      height: 39px;
      min-width: 39px;

      border-radius: 12px;
    }

    .mobile-search-pill input {
      font-size: 0.86rem;
    }
  }
</style>

<nav class="navbar navbar-expand-lg md-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>
      <div class="navbar-nav ms-auto">
        <!-- Desktop search: sirf lg aur upar dikhega -->
        <form class="d-none d-lg-flex position-relative search-form" role="search" action="/listings/search" method="GET" autocomplete="off">
          <input class="form-control me-2 search-inp" type="search" name="query" id="searchInputDesktop" placeholder="Search Destinations" aria-label="Search"/>
          <div class="suggestions-box list-group position-absolute" id="suggestionsBoxDesktop"></div>
          <button class="btn btn-search" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
        </form>
      </div>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Add new Listings</a>
       <% if (typeof currUser === 'undefined' || !currUser){ %>
        <a class="nav-link active" aria-current="page" href="signup"><b>Signup</b></a>
        <a class="nav-link" href="/login"><b>Login</b></a>
         <% } %>
        <% if (typeof currUser !== 'undefined' && currUser){ %>
<a class="nav-link" href="/logout">Logout</a>
  <% } %>
      </div>
    </div>
  </div>

  <!-- Mobile search: compact pill, hamesha visible, hamburger se bahar -->
  <div class="mobile-search-row">
    <form class="mobile-search-pill position-relative" role="search" action="/listings/search" method="GET" autocomplete="off">
      <input type="search" name="query" id="searchInputMobile" placeholder="Search Destinations" aria-label="Search"/>
      <div class="suggestions-box list-group position-absolute" id="suggestionsBoxMobile"></div>
      <button type="submit" aria-label="Search"><i class="fa-solid fa-magnifying-glass"></i></button>
    </form>
  </div>
</nav>

<script>
  function setupSearch(inputId, boxId) {
    const searchInput = document.getElementById(inputId);
    const suggestionsBox = document.getElementById(boxId);
    if (!searchInput || !suggestionsBox) return;
    let debounceTimer;

    searchInput.addEventListener("input", () => {
      clearTimeout(debounceTimer);
      let query = searchInput.value.trim();

      if (query === "") {
        suggestionsBox.style.display = "none";
        suggestionsBox.innerHTML = "";
        return;
      }

      debounceTimer = setTimeout(async () => {
        try {
          let res = await fetch(`/listings/suggestions?query=${encodeURIComponent(query)}`);
          let data = await res.json();

          if (data.length === 0) {
            suggestionsBox.style.display = "none";
            return;
          }

          suggestionsBox.innerHTML = data.map(item => `
            <div class="list-group-item" data-value="${item.location}">
              <b>${item.title}</b> — ${item.location}, ${item.country}
            </div>
          `).join("");

          suggestionsBox.style.display = "block";
        } catch (err) {
          console.log("Suggestion fetch error:", err);
        }
      }, 300);
    });

    suggestionsBox.addEventListener("click", (e) => {
      let item = e.target.closest(".list-group-item");
      if (item) {
        searchInput.value = item.dataset.value;
        suggestionsBox.style.display = "none";
        searchInput.closest("form").submit();
      }
    });

    document.addEventListener("click", (e) => {
      if (!e.target.closest("#" + boxId) && e.target !== searchInput) {
        suggestionsBox.style.display = "none";
      }
    });
  }

  setupSearch("searchInputDesktop", "suggestionsBoxDesktop");
  setupSearch("searchInputMobile", "suggestionsBoxMobile");
</script>